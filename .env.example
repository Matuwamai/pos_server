DATABASE_URL="mysql://user:password@localhost:3306/pos"

SUPER_ADMIN_JWT_SECRET="change-me"
SUPER_ADMIN_JWT_EXPIRES_IN="4h"

# Tenant-user auth — must be a different secret from SUPER_ADMIN_JWT_SECRET.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# Stub billing webhook auth — replace with real provider signature
# verification once a billing provider is chosen (see verifyWebhookSecret.js)
BILLING_WEBHOOK_SECRET="change-me"

PORT=4000
NODE_ENV=development

# Africa's Talking SMS (OTP/MFA, notifications, campaigns) — leave unset to
# use the dev-only fallback that logs OTP codes instead of sending them.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX=true

# Public URL of the web app (used for links in password-reset emails)
APP_URL=http://localhost:5173

# Email (password recovery when a user has no phone on file, or SMS fails).
# Leave SMTP_HOST unset in development to use the log-the-code fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="POS <no-reply@yourdomain.com>"

# Per-IP request limits on public auth endpoints (per 15 min; signup per hour)
RATE_LIMIT_LOGIN=20
RATE_LIMIT_RECOVERY=10
RATE_LIMIT_SIGNUP=10
